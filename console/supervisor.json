{
  "processes": {
    "kaguya_app": {
      "label": "Kaguya App",
      "group": "app",
      "conflicts": ["gateway_standalone", "talker_standalone"],
      "command": "source $HOME/.cargo/env && cargo run --features dev-console",
      "command_win32": "cargo run --features dev-console",
      "cwd": "../gateway",
      "env": {
        "RUST_LOG": "kaguya_gateway=debug"
      }
    },
    "gateway_standalone": {
      "label": "Gateway",
      "group": "standalone",
      "conflicts": ["kaguya_app"],
      "command": "source $HOME/.cargo/env && cargo run --features dev-console",
      "command_win32": "cargo run --features dev-console",
      "cwd": "../gateway",
      "env": { "RUST_LOG": "kaguya_gateway=debug" }
    },
    "talker_standalone": {
      "label": "Talker",
      "group": "standalone",
      "conflicts": ["kaguya_app"],
      "command": ".venv/bin/python main.py",
      "command_win32": ".venv\\Scripts\\python.exe main.py",
      "cwd": "../talker",
      "env": {}
    },
    "llm_server": {
      "label": "LLM server",
      "group": "external",
      "managed": false,
      "health_url": "http://localhost:1234/v1/models",
      "poll_interval_ms": 5000
    }
  }
}
